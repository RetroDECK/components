{
  "sm2-emu": {
    "name": "sm2-emu",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_emulator_guides/sm2-emu/sm2-emu-guide/",
    "url_donation_purchase": "https://github.com/dmanlfc/sm2-emu/blob/main/FUNDING.md",
    "url_source": "https://github.com/dmanlfc/sm2-emu",
    "description": "SEGA Model 2 Arcade emulator.",
    "system_friendly_name": "SEGA Model 2",
    "component_type": "Emulator",
    "system": "model2",
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "SM2-EMU",
            "description": "SEGA Model 2 Emulator sm2-emu",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
        {
          "name": "model2",
          "fullname": "Sega Model 2",
          "path": "%ROMPATH%/model2",
          "extension": ".7z .zip",
          "commands": [
            {
              "label": "sm2-emu (Standalone)",
              "command": "%EMULATOR_SM2-EMU% %ROM%"
            }
          ],
          "platform": "arcade",
          "theme": "model2"
        }
      ]
    },
    "bios": []
  }
}