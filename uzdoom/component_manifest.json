{
  "uzdoom": {
    "name": "UZDoom",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_emulator_guides/uzdoom/uzdoom-guide/",
    "url_webpage": "https://zdoom.org/index",
    "url_donation_purchase": "",
    "url_source": "https://github.com/ZDoom/uzdoom",
    "component_type": "Engine",
    "description": "UZDoom is a modern, enhanced source port engine of classic DOOM and DOOM engine games.",
    "system_friendly_name": "Doom",
    "system": "doom",
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "UZDOOM",
            "description": "UZDoom DOOM Engine",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
        {
          "name": "doom",
          "fullname": "Doom",
          "path": "%ROMPATH%/doom",
          "extension": ".desktop .doom .ipk3 .iwad .pk3 .pk4 .pwad .sh .wad",
          "commands": [
            {
              "label": "UZDoom (Standalone)",
              "command": "%EMULATOR_UZDOOM% %ROM%",
              "priority": 10
            }
          ],
          "platform": "pc, pcwindows",
          "theme": "doom"
        }
      ]
    },
    "helper_files": {
      "doom_guide": {
        "filename": "doom_guide.txt",
        "location": "$roms_path/doom"
      }
    }
  }
}