{
  "zesarux": {
    "name": "ZEsarUX",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_emulator_guides/zesarux/zesarux-guide/",
    "url_donation_purchase": "",
    "url_source": "https://github.com/chernandezba/zesarux",
    "description": "ZEsarUX is a Sinclair ZX Spectrum Next and ZX Machines Emulator",
    "system_friendly_name": "ZX Spectrum Next",
    "component_type": "Emulator",
    "system": "zxnext",
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "ZESARUX",
            "description": "Sinclair ZX Spectrum emulator ZEsarUX",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      }
    },
    "es_systems": [
      {
        "name": "zxnext",
        "fullname": "Sinclair ZX Spectrum Next",
        "path": "%ROMPATH%/zxnext",
        "extension": ".nex .sna",
        "commands": [
          {
            "label": "ZEsarUX (Standalone)",
            "command": "%STARTDIR%=%EMUDIR% %EMULATOR_ZESARUX% --machine tbblue --realvideo --enabletimexvideo --tbblue-fast-boot-mode --enable-esxdos-handler --esxdos-root-dir %GAMEDIR% %ROM%"
          }
        ],
        "platform": "zxnext",
        "theme": "zxnext"
      }
    ]
  }
}