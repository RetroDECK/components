{
  "tsugaru": {
    "name": "Tsugaru",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_emulator_guides/tsugaru/tsugaru-guide/",
    "url_donation_purchase": "",
    "url_source": "https://github.com/captainys/TOWNSEMU",
    "description": "Tsugaru is a Fujitsu FM TOWNS / Marty Emulator (fmtowns)",
    "system_friendly_name": "Fujitsu FM TOWNS / Marty",
    "component_type": "Emulator",
    "system": "fmtowns",
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "TSUGARU",
            "description": "Fujitsu FM Towns Emulator Tsugaru",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      }
    },
    "es_systems": [
      {
        "name": "fmtowns",
        "fullname": "Fujitsu FM Towns emulator Tsugaru",
        "path": "%ROMPATH%/fmtowns",
        "extension": ".cdr .chd .cue .gdi .iso",
        "commands": [
          {
            "label": "Tsugaru (Standalone)",
            "command": "%EMULATOR_TSUGARU% %EMUDIR%/roms -HOSTSHORTCUT ESC 0 0 FORCEQUIT -FULLSCREEN -CD %ROM% %INJECT%=%BASENAME%.cfg"
          }
        ],
        "platform": "fmtowns",
        "theme": "fmtowns"
      }
    ]
  }
}