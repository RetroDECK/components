{
  "ironwail": {
    "name": "Ironwail",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "description": "Quake engine based on QuakeSpasm for playing classic Quake and mods.",
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_engine_guides/ironwail/ironwail-guide/",
    "url_donation_purchase": "",
    "url_source": "https://github.com/andrei-drexler/ironwail/",
    "component_type": "Engine",
    "system_friendly_name": "Quake",
    "system": "quake",
    "backup_data": {
      "core": [
        {
          "path": "$roms_path/quake/ironwail/id1"
        }
      ]
    },
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "IRONWAIL",
            "description": "Ironwail - Quake Engine",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
        {
          "name": "quake",
          "fullname": "Quake",
          "path": "%ROMPATH%/quake",
          "extension": ".pak .pk3 .quake",
          "commands": [
            {
              "label": "Ironwail (Standalone)",
              "command": "%EMULATOR_IRONWAIL%",
              "priority": 10
            }
          ],
          "platform": "pc, pcwindows",
          "theme": "quake"
        }
      ]
    }
  }
}