      "es_find_rules": {
        "emulators": [
          {
            "name": "ARES",
            "description": "ares multi-emulator.",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
