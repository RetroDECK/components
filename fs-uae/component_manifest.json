              "command": "%EMULATOR_FS-UAE% /var/config/fs-uae/RetroDECK-amiga1200.fs-uae %ROM%",
              "priority": 30
            },
            {
              "label": "FS-UAE (Standalone) Custom Amiga 1200",
              "command": "%EMULATOR_FS-UAE% /var/config/fs-uae/Custom/custom-amiga1200.fs-uae %ROM%",
              "priority": 40
            }
          ],
          "platform": "amiga1200",
          "theme": "amiga1200"
        },
        {
          "name": "amiga600",
