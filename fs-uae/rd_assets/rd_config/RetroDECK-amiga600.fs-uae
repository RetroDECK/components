floppy_drive_count = 2

video_sync = auto
low_latency_vsync = 1

texture_filter = nearest
smoothing = 0

joystick_port_1_mode = joystick

keep_aspect = 1
ntsc_mode = 0
scale = 1

fullscreen = 1

scanlines = 0
border = 0
bezel = 0

fade_in_duration = 0
fade_out_duration = 0

floppy_drive_volume = 0

game_mode = 1
