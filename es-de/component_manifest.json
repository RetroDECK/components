{
  "es-de": {
    "description": "ES-DE Frontend.",
    "name": "ES-DE",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset"
    ],
    "component_type": "Frontend",
    "prepare_priority": {
      "reset": 10,
      "postmove": 10,
      "startup": 99,
      "shutdown": 10
    },
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_system_guides/es-de/esde-guide/.",
    "url_webpage": "https://es-de.org/",
    "url_donation_purchase": "https://www.patreon.com/es_de/",
    "url_source": "https://gitlab.com/es-de/emulationstation-de",
    "component_options": {
      "esde_engine_launch_scripts": "false"
    },
    "backup_data": {
      "core": [
        {
          "path": "$XDG_CONFIG_HOME/ES-DE"
        },
        {
          "path": "$esde_gamelists_path"
        },
        {
          "path": "$esde_collections_path"
        },
        {
          "path": "$esde_custom_systems_path"
        },
        {
          "path": "$esde_scripts_path"
        }
      ],
      "complete": [
        {
          "path": "$esde_gamelists_path"
        },
        {
          "path": "$esde_collections_path"
        },
        {
          "path": "$esde_custom_systems_path"
        },
        {
          "path": "$esde_downloaded_media_path"
        },
        {
          "path": "$esde_scripts_path"
        },
        {
          "path": "$esde_screensavers_path"
        },
        {
          "path": "$esde_themes_path"
        }
      ]
    },
    "component_paths": {
      "esde_downloaded_media_path": {
        "path": "$rd_home_path/ES-DE/downloaded_media",
        "recommended_scope": "shared",
        "description": "Scraped game artwork and media"
      },
      "esde_themes_path": {
        "path": "$rd_home_path/ES-DE/themes",
        "recommended_scope": "shared",
        "description": "ES-DE frontend themes"
      },
      "esde_gamelists_path": {
        "path": "$rd_home_path/ES-DE/gamelists",
        "recommended_scope": "per-user",
        "description": "Game metadata, favorites, and play history"
      },
      "esde_collections_path": {
        "path": "$rd_home_path/ES-DE/collections",
        "recommended_scope": "per-user",
        "description": "User-curated game collections"
      },
      "esde_custom_systems_path": {
        "path": "$rd_home_path/ES-DE/custom_systems",
        "recommended_scope": "shared",
        "description": "Custom system definitions for ES-DE"
      },
      "esde_scripts_path": {
        "path": "$rd_home_path/ES-DE/scripts",
        "recommended_scope": "shared",
        "description": "ES-DE event scripts"
      },
      "esde_screensavers_path": {
        "path": "$rd_home_path/ES-DE/screensavers",
        "recommended_scope": "shared",
        "description": "ES-DE screensaver media"
      }
    },
    "cli_commands": [
      {
        "flag": "--generate-esde-diff",
        "description": "Generate a diff report comparing the RetroDECK-generated ES-DE files and official upstream versions.",
        "handler": "generate_es_de_diff_report",
        "dev_tool": true
      }
    ],
    "configurator_menus": {
      "data_management": [
        {
          "name": "ROMs Folder: Rebuild Systems",
          "description": "Recreate any missing system folders in the roms directory.",
          "command": {
            "zenity": "configurator_rebuild_esde_systems::es-de"
          }
        }
      ]
    },
    "helper_files": [
      {
        "filename": "es_find_rules_template.xml",
        "location": "$esde_custom_systems_path"
      },
      {
        "filename": "es_systems_template.xml",
        "location": "$esde_custom_systems_path"
      }
    ],
