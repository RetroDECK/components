{
  "scummvm": {
    "name": "ScummVM",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_engine_guides/scummvm/scummvm-guide/",
    "url_webpage": "https://www.scummvm.org/",
    "url_donation_purchase": "https://www.scummvm.org/",
    "url_source": "https://www.scummvm.org/",
    "component_type": "Engine",
    "description": "Adventure game engine for running classic graphical adventure and role-playing games.",
    "system_friendly_name": "ScummVM",
    "system": "scummvm",
    "compatible_presets": {
      "ask_to_exit": [
        "false",
        "true"
      ]
    },
    "preset_actions": {
      "config_file_format": "scummvm",
      "ask_to_exit": [
        {
          "enabled_states": [
            "true"
          ],
          "setting_name": "confirm_exit",
          "action": "change",
          "new_setting_value": "true",
          "section": "",
          "target_file": "$scummvm_config",
          "defaults_file": "$config/scummvm/scummvm.ini"
        }
      ],
      "es_de_config": {
        "es_find_rules": {
          "emulators": [
            {
              "name": "SCUMMVM",
              "description": "ScummVM Game Engine",
              "rules": [
                {
                  "type": "staticpath",
                  "entries": [
                    "%COMPONENT_PATH%/component_launcher.sh"
                  ]
                }
              ]
            }
          ]
        },
        "es_systems": [
          {
            "name": "scummvm",
            "fullname": "ScummVM Game Engine",
            "path": "%ROMPATH%/scummvm",
            "extension": ".scummvm",
            "commands": [
              {
                "label": "ScummVM (Standalone)",
                "command": "%STARTDIR%=%GAMEDIR% %EMULATOR_SCUMMVM% %BASENAME%",
                "priority": 10
              }
            ],
            "platform": "scummvm",
            "theme": "scummvm"
          }
        ]
      }
    }
  }
}