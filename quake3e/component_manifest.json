  "quake3e": {
    "name": "Quake3e",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_client_guides/quake3e/quake3e-guide/",
