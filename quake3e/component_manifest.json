          "name": "quake3",
          "fullname": "Quake 3",
          "path": "%ROMPATH%/quake3",
          "extension": ".quake3",
          "commands": [
            {
              "label": "Quake3e (Standalone)",
              "command": "%EMULATOR_QUAKE3E% +set fs_game %BASENAME%",
              "priority": 10
            }
          ],
