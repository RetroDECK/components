{
  "simcoupe": {
    "name": "SimCoupé",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_emulator_guides/simcoupe/simcoupe-guide/",
    "url_webpage": "https://simonowen.com/simcoupe/",
    "url_donation_purchase": "",
    "url_source": "https://github.com/simonowen/simcoupe",
    "component_type": "Emulator",
    "description": "SimCoupé is a MGT SAM Coupé (samcoupe) 8-bit computer emulator.",
    "system_friendly_name": "MGT SAM Coupé",
    "system": "samcoupe",
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "SIMCOUPE",
            "description": "SAM Coupé Emulator SimCoupé",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
        {
          "name": "samcoupe",
          "fullname": "MGT SAM Coupé",
          "path": "%ROMPATH%/samcoupe",
          "extension": ".dsk .mgt .sad .sbt .7z .zip",
          "commands": [
            {
              "label": "SimCoupé (Standalone)",
              "command": "%STARTDIR%=%EMULATOR_SIMCOUPE% %ROM%"
            }
          ],
          "platform": "samcoupe",
          "theme": "samcoupe"
        }
      ]
    }
  }
}